<windows:PAIConfigureWindow
                      xmlns="https://spacestation14.io"
                      xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:sl="clr-namespace:Content.Client._Starlight.Character.Info.UI"
                      xmlns:windows="clr-namespace:Content.Client._Starlight.PAI"
                      Title="{Loc 'pai-system-configure-title'}"
                      MinWidth="900"
                      MinHeight="520">
<TabContainer Name="PAIConfigureTabs" Access="Public" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" Margin="15 15 15 10">

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" >

            <!-- the general overview and customization buttons -->
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical"
                              VerticalAlignment="Center"
                              VerticalExpand="True"
                              SeparationOverride="4"
                              Margin="0 0 0 0"
                              MinWidth="130">
                    <RichTextLabel Name="PAIName"
                                   Access="Public"
                                   HorizontalAlignment="Center"
                                   Text="pAI Name"/>
                    <RichTextLabel Name="OwnerName"
                                   Access="Public"
                                   HorizontalAlignment="Center"
                                   Text="Owner Name"/>
                    <PanelContainer StyleClasses="LowDivider"/>
                    <SpriteView Name="SpriteView"
                                Access="Public"
                                OverrideDirection="South"
                                Scale="4 4"
                                HorizontalAlignment="Center"/>
                    <PanelContainer StyleClasses="LowDivider"/>
                    <Control Margin="5"/>
                    <BoxContainer> <!-- the rename field -->
                        <LineEdit HorizontalExpand="True"></LineEdit>
                        <Button Text="Rename"></Button>
                    </BoxContainer>
                    <BoxContainer>
                        <RichTextLabel Text="Voice:" HorizontalExpand="True"></RichTextLabel>
                        <OptionButton MinWidth="300"></OptionButton>
                    </BoxContainer>
                    <BoxContainer>
                        <ColorSelectorSliders HorizontalExpand="True"></ColorSelectorSliders>
                    </BoxContainer>

                </BoxContainer>
            </ScrollContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="20"/>
            <!-- objectives list -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <RichTextLabel Text="{Loc 'character-info-objectives-header'}"/>
                <PanelContainer StyleClasses="PanelDark"
                                Margin="0 0 10 0"
                                MinWidth="220"
                                HorizontalExpand="True"
                                VerticalExpand="True">
                    <ScrollContainer Name="ObjectivesScroll"
                                     Access="Public"
                                     HScrollEnabled="False"
                                     MinWidth="270"
                                     VerticalExpand="True">
                        <BoxContainer Name="ObjectivesWrapper"
                                      Access="Public"
                                      Orientation="Vertical">
                            <Button Name="ObjectiveButton"
                                    StyleClasses="OpenBoth"
                                    Margin="2 2 2 0"
                                    VerticalExpand="False"
                                    VerticalAlignment="Top"/>
                            <Button Name="CardsButton"
                                    Access="Public"
                                    StyleClasses="OpenBoth"
                                    Text="{Loc 'character-info-cards-button'}"
                                    Margin="2 2 2 0"/>
                            <Label Name="NoObjectivesLabel"
                                   Text="{Loc 'character-info-no-objectives'}"
                                   StyleClasses="LabelSubText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   VerticalExpand="False"/>
                            <BoxContainer Name="Objectives"
                                          Access="Public"
                                          Orientation="Vertical"
                                          Margin="0 2 0 0"
                                          SeparationOverride="2"/>
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

        </BoxContainer>

        <!-- This thing... I keep it so that its compatible with the old UI code -->
        <cc:Placeholder Name="RolePlaceholder"
                        Access="Public"
                        Visible="False"/>

    </BoxContainer>
    <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="15 15 15 10" VerticalExpand="True">
        <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True" SizeFlagsStretchRatio="1" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <sl:CharacterICInfoControl Name="InfoIC" Access="Public" Margin="10"/>
            </ScrollContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True" SizeFlagsStretchRatio="1" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <sl:CharacterOOCInfoControl Name="InfoOOC" Access="Public" Margin="10"/>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</TabContainer>
</windows:PAIConfigureWindow>
